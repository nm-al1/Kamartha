# ============================================================
# TAG 1 - SAKLAR PROFIL: local | supabase
# ============================================================
APP_PROFILE=local

# ============================================================
# TAG 2 - PROFIL LOCAL
# ============================================================
LOCAL_ENVIRONMENT=development
LOCAL_APP_ORIGIN=http://localhost:8080
LOCAL_MIGRATION_DATABASE_URL=
LOCAL_DATABASE_URL=
LOCAL_SETUP_CODE_HASH=
LOCAL_IP_HASH_SECRET=
LOCAL_SETUP_CODE=

# ============================================================
# TAG 3 - PROFIL SUPABASE
# Session pooler port 5432, sslmode=require, role runtime bukan postgres.
# ============================================================
SUPABASE_ENVIRONMENT=production
SUPABASE_APP_ORIGIN=https://kamartha.example
SUPABASE_MIGRATION_DATABASE_URL=
SUPABASE_DATABASE_URL=
SUPABASE_SETUP_CODE_HASH=
SUPABASE_IP_HASH_SECRET=
SUPABASE_SETUP_CODE=

# ============================================================
# TAG 4 - STORAGE SUPABASE (hanya saat APP_PROFILE=supabase)
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=kamartha-files
